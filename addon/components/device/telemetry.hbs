<div class="mt-2 space-y-1 text-xs" data-test-device-telemetry {{did-update this.resourceChanged @resource.id}}>
    <p><strong>{{if this.stale (t "fleetops-ui.components.device.telemetry.position-stale") (t "fleetops-ui.components.device.telemetry.position-current")}}</strong> · {{this.ageLabel}}</p>
    <p title={{@resource.meta.telemetry.position_at}}>{{t "fleetops-ui.components.device.telemetry.device-position" positionTime=this.positionTime}}</p>
    <p title={{@resource.meta.telemetry.provider_at}}>{{t "fleetops-ui.components.device.telemetry.provider-transmission" providerTime=this.providerTime}}</p>
    <details><summary>{{t "fleetops-ui.components.device.telemetry.telemetry-timing-utc"}}</summary>
        <p>{{t "fleetops-ui.components.device.telemetry.device" position_at=(n-a @resource.meta.telemetry.position_at)}}</p>
        <p>{{t "fleetops-ui.components.device.telemetry.provider" provider_at=(n-a @resource.meta.telemetry.provider_at)}}</p>
        <p>{{t "fleetops-ui.components.device.telemetry.received" received_at=(n-a @resource.meta.telemetry.received_at)}}</p>
        <p>{{t "fleetops-ui.components.device.telemetry.processed" processed_at=(n-a @resource.meta.telemetry.processed_at)}}</p>
        <p>{{t
                "fleetops-ui.components.device.telemetry.source-queue-delay-s-source-delay"
                source=(n-a @resource.meta.telemetry.source)
                queue_delay_seconds=(n-a @resource.meta.telemetry.queue_delay_seconds)
                source_delay_seconds=(n-a @resource.meta.telemetry.source_delay_seconds)
            }}</p>
    </details>
    {{#if this.connectionError}}<p role="status">{{t "fleetops-ui.components.device.telemetry.live-updates-interrupted-displaying-the-last"}}</p>{{/if}}
</div>