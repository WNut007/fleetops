<div class="flex flex-col gap-3 p-3" ...attributes>
    <section class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="flex flex-col gap-3 p-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h2 class="truncate text-base font-bold text-gray-900 dark:text-gray-100">{{smart-humanize this.eventType}}</h2>
                    <Badge @status={{this.severity}} @hideStatusDot={{true}}>{{enum-label "severity" this.severity}}</Badge>
                    <Badge @status={{this.processedStatus}} @hideStatusDot={{true}}>{{this.processedLabel}}</Badge>
                </div>

                <p class="mt-2 max-w-4xl text-sm leading-5 text-gray-700 dark:text-gray-200">{{n-a this.message}}</p>

                <div class="mt-2 flex flex-wrap gap-2 text-xs text-gray-500 dark:text-gray-300">
                    <span>{{t "fleetops-ui.components.device-event.details.occurred" na=(n-a (format-date-fns this.occurredAt "dd MMM yyyy, HH:mm"))}}</span>
                    <span>{{t "fleetops-ui.components.device-event.details.processed" na=(n-a (format-date-fns this.processedAt "dd MMM yyyy, HH:mm"))}}</span>
                    <span>{{t "fleetops-ui.components.device-event.details.public-id" public_id=(n-a @resource.public_id)}}</span>
                    <span>UUID: {{n-a @resource.id}}</span>
                </div>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {{#each this.metrics as |metric|}}
            <div
                class="fleet-ops-widget fleet-ops-kpi-tile fleetops-connectivity-kpi-tile
                    {{metric.accentClass}}
                    relative min-h-[82px] overflow-hidden rounded-md border bg-white shadow-sm dark:bg-gray-800"
            >
                <div class="flex h-full items-start justify-between gap-2 p-3">
                    <div class="min-w-0">
                        <div class="truncate text-[10px] font-bold uppercase text-gray-500 dark:text-gray-400">{{metric.label}}</div>
                        <div class="mt-1 truncate text-lg font-extrabold leading-none text-gray-900 dark:text-gray-50">{{n-a metric.value}}</div>
                        {{#if metric.meta}}
                            <div class="mt-1 truncate text-xs text-gray-500 dark:text-gray-300">{{metric.meta}}</div>
                        {{/if}}
                    </div>
                    <div class="fleetops-connectivity-kpi-icon flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-md text-[13px]">
                        <FaIcon @icon={{metric.icon}} />
                    </div>
                </div>
            </div>
        {{/each}}
    </section>

    <section class="grid grid-cols-1 gap-3 xl:grid-cols-2">
        <div class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-3 py-2 dark:border-gray-700">
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.components.device-event.details.event-details"}}</h3>
            </div>
            <div class="grid grid-cols-1 gap-2 p-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.event-type"}}</div>
                    <div class="field-value">{{n-a (smart-humanize this.eventType)}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.severity"}}</div>
                    <div class="field-value"><Badge @status={{this.severity}}>{{enum-label "severity" this.severity}}</Badge></div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.state"}}</div>
                    <div class="field-value">{{n-a (smart-humanize @resource.state)}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.code"}}</div>
                    <div class="field-value">{{n-a @resource.code}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.reason"}}</div>
                    <div class="field-value">{{n-a @resource.reason}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.mileage"}}</div>
                    <div class="field-value">{{n-a @resource.mileage}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.age"}}</div>
                    <div class="field-value">{{#if this.ageMinutes}}{{t "fleetops-ui.components.device-event.details.minutes" ageMinutes=this.ageMinutes}}{{else}}{{n-a null}}{{/if}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.processing-delay"}}</div>
                    <div class="field-value">{{#if this.processingDelay}}{{t "fleetops-ui.components.device-event.details.minutes-2" processingDelay=this.processingDelay}}{{else}}{{n-a
                                null
                            }}{{/if}}</div>
                </div>
                <div class="field-info-container sm:col-span-2 lg:col-span-3">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.comment"}}</div>
                    <div class="field-value whitespace-pre-line">{{n-a @resource.comment}}</div>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-3 py-2 dark:border-gray-700">
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.components.device-event.details.device-provider"}}</h3>
            </div>
            <div class="grid grid-cols-1 gap-2 p-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.device"}}</div>
                    <div class="field-value">
                        {{#let (resource-relation this.resource "device") as |device|}}
                            <Device::Pill
                                @device={{device}}
                                @titleFallback={{n-a this.deviceName}}
                                @onClick={{unless device (if this.deviceRouteModel this.openDevice)}}
                                data-test-device-event-device-link
                            />
                        {{/let}}
                    </div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.device-uuid"}}</div>
                    <div class="field-value">{{n-a @resource.device_uuid}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.device-id"}}</div>
                    <div class="field-value">{{n-a @resource.device_id}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">IMEI</div>
                    <div class="field-value">{{n-a @resource.device_imei}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.serial-number"}}</div>
                    <div class="field-value">{{n-a @resource.device_serial_number}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">IDENT</div>
                    <div class="field-value">{{n-a @resource.ident}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.provider"}}</div>
                    <div class="field-value">
                        {{#let (resource-relation this.resource "telematic") as |telematic|}}
                            <Telematic::Pill
                                @telematic={{telematic}}
                                @titleFallback={{n-a this.providerLabel}}
                                @onClick={{unless telematic (if this.telematicRouteModel this.openTelematic)}}
                                data-test-device-event-telematic-link
                            />
                        {{/let}}
                    </div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.protocol"}}</div>
                    <div class="field-value">{{n-a @resource.protocol}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.telematic-uuid"}}</div>
                    <div class="field-value">{{n-a @resource.telematic_uuid}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "fleetops-ui.components.device-event.details.device-status"}}</div>
                    <div class="field-value" data-test-device-event-device-status>
                        {{#if this.deviceStatus}}
                            <Badge @status={{this.deviceStatus}} />
                        {{else}}
                            {{n-a null}}
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-3 xl:grid-cols-3">
        <div class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-3 py-2 dark:border-gray-700">
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.components.device-event.details.payload"}}</h3>
            </div>
            <pre class="max-h-80 overflow-auto bg-gray-900 p-3 text-[11px] leading-5 text-gray-100">{{n-a this.payloadJson}}</pre>
        </div>

        <div class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-3 py-2 dark:border-gray-700">
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.components.device-event.details.data"}}</h3>
            </div>
            <pre class="max-h-80 overflow-auto bg-gray-900 p-3 text-[11px] leading-5 text-gray-100">{{n-a this.dataJson}}</pre>
        </div>

        <div class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-3 py-2 dark:border-gray-700">
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.components.device-event.details.meta"}}</h3>
            </div>
            <pre class="max-h-80 overflow-auto bg-gray-900 p-3 text-[11px] leading-5 text-gray-100">{{n-a this.metaJson}}</pre>
        </div>
    </section>

    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />
</div>