<div class="form-wrapper" ...attributes>
    <ContentPanel @title={{t "fleetops-ui.components.warranty.form.warranty-details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <InputGroup @name={{t "fleetops-ui.components.warranty.form.provider"}} @wrapperClass="col-span-2">
                <Input
                    @value={{@resource.provider}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "fleetops-ui.components.warranty.form.provider"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "fleetops-ui.components.warranty.form.policy-number"}}>
                <Input
                    @value={{@resource.policy_number}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "fleetops-ui.components.warranty.form.policy-number"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "fleetops-ui.components.warranty.form.vendor"}}>
                <ModelSelect
                    @modelName="vendor"
                    @selectedItemComponent={{component "select-option/vendor" compact=true}}
                    @selectedModel={{@resource.vendor}}
                    @placeholder={{t "fleetops-ui.components.warranty.form.select-vendor"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{fn (mut @resource.vendor)}}
                    @onChangeId={{fn (mut @resource.vendor_uuid)}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    <SelectOption::Vendor @option={{model}} />
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "fleetops-ui.components.warranty.form.start-date"}}>
                <DatePicker
                    @value={{format-date-fns @resource.start_date "yyyy-MM-dd"}}
                    @onChange={{fn (mut @resource.start_date)}}
                    @placeholder={{t "fleetops-ui.components.warranty.form.select-start-date"}}
                    @disabled={{cannot-write @resource}}
                    class="w-full form-input"
                />
            </InputGroup>

            <InputGroup @name={{t "fleetops-ui.components.warranty.form.end-date"}}>
                <DatePicker
                    @value={{format-date-fns @resource.end_date "yyyy-MM-dd"}}
                    @onChange={{fn (mut @resource.end_date)}}
                    @placeholder={{t "fleetops-ui.components.warranty.form.select-end-date"}}
                    @disabled={{cannot-write @resource}}
                    class="w-full form-input"
                />
            </InputGroup>

            <InputGroup @name={{t "fleetops-ui.components.warranty.form.terms"}} @wrapperClass="col-span-2">
                <Textarea
                    @value={{@resource.terms}}
                    aria-label={{t "fleetops-ui.components.warranty.form.terms"}}
                    class="w-full form-input"
                    disabled={{cannot-write @resource}}
                    placeholder={{t "fleetops-ui.components.warranty.form.warranty-terms"}}
                    rows={{5}}
                />
            </InputGroup>

            <InputGroup @name={{t "fleetops-ui.components.warranty.form.policy-document"}} @wrapperClass="col-span-2">
                <Textarea
                    @value={{@resource.policy}}
                    aria-label={{t "fleetops-ui.components.warranty.form.policy"}}
                    class="w-full form-input"
                    disabled={{cannot-write @resource}}
                    placeholder={{t "fleetops-ui.components.warranty.form.policy-document"}}
                    rows={{5}}
                />
            </InputGroup>

            <RegistryYield @registry="fleet-ops:component:warranty:form:details" as |RegistryComponent|>
                <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
            </RegistryYield>
        </div>
    </ContentPanel>

    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />

    <RegistryYield @registry="fleet-ops:component:warranty:form" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>
</div>