{{!
    live-map component
    ─────────────────────────────────────────────────────────────────────────
    Supports two map providers:
      • "leaflet" (default) — uses ember-leaflet / Leaflet.js
      • "google"            — uses ember-google-maps / Google Maps JS API

    The active provider is read from `this.mapManager.activeProvider`.
    Set `ENV.mapProvider = 'google'` in environment.js to switch globally,
    or pass `@mapProvider="google"` as a component argument to override.

    Both branches share the same JS component class and all services route
    through the provider-agnostic MapManagerService.
}}

<div
    class="live-map-component {{@wrapperClass}}"
    {{did-update this.syncServiceAreaContextMenus this.serviceAreaActions.serviceAreas this.serviceAreaActions.serviceAreas.length}}
    {{did-update this.syncMarkers this.markersReady this.drivers this.vehicles this.places}}
>

    {{#if this.shouldUseGoogleMaps}}
        {{! ─── Google Maps branch ──────────────────────────────────────────── }}
        <Map::GoogleLiveMap
            @latitude={{this.latitude}}
            @longitude={{this.longitude}}
            @zoom={{this.zoom}}
            @drivers={{this.drivers}}
            @vehicles={{this.vehicles}}
            @places={{this.places}}
            @serviceAreas={{this.serviceAreaActions.serviceAreas}}
            @ready={{this.load.isIdle}}
            @onLoad={{this.didLoadGoogleMap}}
            @onViewportChanged={{perform this.reloadResourcesInViewport}}
            @onDriverAdded={{fn this.trigger "onDriverAdded"}}
            @onDriverClicked={{fn this.trigger "onDriverClicked"}}
            @onVehicleAdded={{fn this.trigger "onVehicleAdded"}}
            @onVehicleClicked={{fn this.trigger "onVehicleClicked"}}
            @onPlaceAdded={{fn this.trigger "onPlaceAdded"}}
            @onPlaceClicked={{fn this.trigger "onPlaceClicked"}}
            @onServiceAreaLayerAdded={{fn this.trigger "onServiceAreaLayerAdded"}}
            @onZoneLayerAdd={{fn this.trigger "onZoneLayerAdd"}}
            @mapClass={{@mapClass}}
            ...attributes
        />
    {{else if this.leafletPluginsReady}}
        {{! ─── Leaflet branch (default) ────────────────────────────────────── }}
        <LeafletMap
            id={{this.id}}
            class="next-leaflet-container-map {{@mapClass}}"
            @lat={{this.latitude}}
            @lng={{this.longitude}}
            @zoom={{this.zoom}}
            @zoomControl={{false}}
            @contextmenu={{true}}
            @contextmenuWidth={{140}}
            @onLoad={{this.didLoad}}
            {{set-container-dimensions}}
            ...attributes
            as |layers|
        >
            <layers.tile @url={{this.tileUrl}} />

            <layers.draw-control
                @position="topright"
                @draw={{hash marker=false circlemarker=false polyline=false}}
                @onDrawDrawstop={{fn this.trigger "onDrawDrawstop"}}
                @onDrawDeleted={{fn this.trigger "onDrawDeleted"}}
                @onDrawEdited={{fn this.trigger "onDrawEdited"}}
                @onDrawDeletestart={{fn this.trigger "onDrawDeletestart"}}
                @onDrawEditstop={{fn this.trigger "onDrawEditstop"}}
                @onDrawControlCreated={{this.didCreateDrawControl}}
                @onDrawFeatureGroupCreated={{this.didCreateDrawControlFeatureGroup}}
            />

            {{#if this.load.isIdle}}
                {{! Driver, vehicle and place markers are drawn by utils/live-map-markers (Leaflet
                    directly): one ember-leaflet component per marker cost 3-4 s for ~300 markers. }}

                {{#each this.serviceAreaActions.serviceAreas as |serviceArea|}}
                    <layers.polygon
                        @id={{serviceArea.id}}
                        @record={{serviceArea}}
                        @locations={{unwrap-coordinates serviceArea.leafletCoordinates}}
                        @fillColor={{or serviceArea.color "#3388ff"}}
                        @color={{or serviceArea.stroke_color serviceArea.color "#3388ff"}}
                        @onAdd={{fn this.trigger "onServiceAreaLayerAdded" serviceArea}}
                        as |polygon|
                    >
                        <polygon.tooltip @permanent={{true}} @sticky={{true}}>{{serviceArea.name}} {{t "resource.service-area"}}</polygon.tooltip>
                    </layers.polygon>

                    {{#each serviceArea.zones as |zone|}}
                        <layers.polygon
                            @id={{zone.id}}
                            @record={{zone}}
                            @locations={{unwrap-coordinates zone.leafletCoordinates}}
                            @fillColor={{or zone.color "#3388ff"}}
                            @color={{or zone.stroke_color zone.color "#3388ff"}}
                            @onAdd={{fn this.trigger "onZoneLayerAdd" zone}}
                            as |polygon|
                        >
                            <polygon.tooltip @permanent={{true}} @sticky={{true}}>{{zone.name}} {{t "resource.zone"}}</polygon.tooltip>
                        </layers.polygon>
                    {{/each}}
                {{/each}}
            {{/if}}

            {{yield layers}}
        </LeafletMap>
    {{/if}}

    {{#if this.tooltipRecord}}
        {{#in-element this.tooltipElement}}
            {{#if (eq this.tooltipType "driver")}}
                <Map::MarkerCard::Driver @driver={{this.tooltipRecord}} @variant="tooltip" />
            {{else}}
                <Map::MarkerCard::Vehicle @vehicle={{this.tooltipRecord}} @variant="tooltip" />
            {{/if}}
        {{/in-element}}
    {{/if}}

    {{#unless this.ready}}
        <div class="flex w-full h-full items-center justify-center">
            <Spinner />
        </div>
    {{/unless}}
</div>

{{!-- {{#if (and this.isDataLoaded (not-eq @drawerTab false))}}
    <LiveMapDrawer
        @tab={{@drawerTab}}
        @onTabChanged={{@onDrawerTabChanged}}
        @onResizeEnd={{@onDrawerResizeEnd}}
        @onResizeStart={{@onDrawerResizeStart}}
        @isMinimized={{@isDrawerMinimized}}
        @isOpen={{@isDrawerOpen}}
        @vehicles={{this.vehicles}}
        @drivers={{this.drivers}}
        @places={{this.places}}
        @liveMap={{this}}
        @onDrawerReady={{this.setDrawerContext}}
    />
{{/if}} --}}
