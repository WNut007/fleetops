<div class="flex flex-row items-center px-5 py-2 border-b border-gray-200 dark:border-gray-700">
    <div>
        <Input @value={{this.query}} @type="text" class="form-input form-input-sm w-60" placeholder={{t "live-map-drawer.place-listing.message"}} />
    </div>
</div>
<Table
    @rows={{this.visiblePlaces}}
    @columns={{this.columns}}
    @searchQuery={{this.query}}
    @emptyStateComponent={{component
        "table/empty-state"
        variant="compact"
        icon="location-dot"
        title=(t "fleetops-ui.components.map.drawer.place-listing.hp.no-places-visible")
        description=(t "fleetops-ui.components.map.drawer.place-listing.hp.places-appear-here-when-they-are")
        filteredTitle=(t "fleetops-ui.components.map.drawer.place-listing.hp.no-places-match-this-search")
        filteredDescription=(t "fleetops-ui.components.map.drawer.place-listing.hp.adjust-the-search-to-find-another")
    }}
/>
{{#if this.hiddenCount}}
    <div class="flex items-center justify-center border-t border-gray-200 px-5 py-2 dark:border-gray-700" data-test-map-drawer-show-more>
        <Button @size="xs" @text={{t "fleetops-ui.components.map.drawer.show-more" count=this.hiddenCount}} @onClick={{this.showMore}} />
    </div>
{{/if}}