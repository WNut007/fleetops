<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup
            @name={{t "fleetops-ui.components.modals.issue-assign.assignee"}}
            @helpText={{t "fleetops-ui.components.modals.issue-assign.choose-the-operator-responsible-for-following"}}
        >
            <ModelSelect
                @modelName="user"
                @selectedItemComponent={{component "select-option/user" compact=true}}
                @selectedModel={{this.selectedAssignee}}
                @placeholder={{t "fleetops-ui.components.modals.issue-assign.select-assignee"}}
                @triggerClass="form-select form-input"
                @infiniteScroll={{false}}
                @renderInPlace={{true}}
                @query={{hash is_not_customer=true}}
                @allowClear={{true}}
                @onChange={{fn (mut this.selectedAssignee)}}
                as |model|
            >
                <SelectOption::User @option={{model}} />
            </ModelSelect>
        </InputGroup>
    </div>
</Modal::Default>