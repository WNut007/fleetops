<div class="space-y-6">
    <InfoBlock @type="info" @icon="circle-info" class="mb-4">
        {{t "fleetops-ui.components.admin.routing-settings.configure-system-wide-routing-engine-defaults"}}
    </InfoBlock>

    <ContentPanel @title={{t "fleetops-ui.components.admin.routing-settings.provider-access"}} @open={{true}} @wrapperClass="bordered-classic">
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
            {{t "fleetops-ui.components.admin.routing-settings.choose-which-providers-organizations-may-use"}}
        </p>
        <div class="space-y-3">
            {{#each this.providerAccessRows as |provider|}}
                <div class="flex items-center justify-between rounded-md border border-gray-200 px-3 py-2 dark:border-gray-700" data-test-provider-access={{provider.key}}>
                    <div>
                        <div class="text-sm font-semibold">{{provider.label}}</div>
                        {{#if provider.billed}}
                            <div class="text-xs text-red-600 dark:text-red-400">{{t "fleetops-ui.components.admin.routing-settings.billed-per-request-to-the-platform"}}</div>
                        {{/if}}
                    </div>
                    <Toggle @isToggled={{provider.enabled}} @onToggle={{fn this.toggleProvider provider.key}} />
                </div>
            {{/each}}
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "fleetops-ui.components.admin.routing-settings.routing-defaults"}} @open={{true}} @wrapperClass="bordered-classic">
        <InputGroup
            @name={{t "fleetops-ui.components.admin.routing-settings.default-routing-engine"}}
            @helpText={{t "fleetops-ui.components.admin.routing-settings.used-for-everything-route-distance-and"}}
        >
            <Select
                class="w-full"
                @value={{this.defaultDisplayEngine}}
                @options={{this.displayEngineOptions}}
                @optionLabel="name"
                @optionValue="key"
                @placeholder={{t "fleetops-ui.components.admin.routing-settings.select-default-routing-engine"}}
                @onSelect={{fn (mut this.defaultDisplayEngine)}}
            />
        </InputGroup>
        <InputGroup
            @name={{t "fleetops-ui.components.admin.routing-settings.default-route-optimization-engine"}}
            @helpText={{t "fleetops-ui.components.admin.routing-settings.decides-the-order-stops-are-visited"}}
        >
            <Select
                class="w-full"
                @value={{this.defaultOptimizationEngine}}
                @options={{this.optimizationEngineOptions}}
                @optionLabel="name"
                @optionValue="key"
                @placeholder={{t "fleetops-ui.components.admin.routing-settings.select-default-route-optimization-engine"}}
                @onSelect={{fn (mut this.defaultOptimizationEngine)}}
            />
        </InputGroup>
        <InputGroup
            @name={{t "fleetops-ui.components.admin.routing-settings.server-side-routing"}}
            @helpText={{t "fleetops-ui.components.admin.routing-settings.straight-line-stops-every-routing-call"}}
        >
            <Select
                class="w-full"
                @value={{this.serverRouting}}
                @options={{this.serverRoutingOptions}}
                @optionLabel="label"
                @optionValue="value"
                @onSelect={{fn (mut this.serverRouting)}}
                data-test-server-routing
            />
        </InputGroup>
    </ContentPanel>

    <ContentPanel @title={{t "fleetops-ui.components.admin.routing-settings.osrm-server"}} @open={{true}} @wrapperClass="bordered-classic">
        <InputGroup @name={{t "fleetops-ui.components.admin.routing-settings.osrm-host"}} @helpText={{this.osrmHelpText}}>
            <Input @value={{this.osrmHost}} placeholder="https://osrm.example.com" class="w-full form-input" data-test-osrm-host />
        </InputGroup>
    </ContentPanel>

    <ContentPanel @title={{t "fleetops-ui.components.admin.routing-settings.organization-exceptions"}} @open={{true}} @wrapperClass="bordered-classic">
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
            {{t "fleetops-ui.components.admin.routing-settings.switch-a-provider-on-for-specific"}}
        </p>
        <div class="space-y-3">
            {{#each this.providerExceptionRows as |row|}}
                <div class="flex items-center gap-3 rounded-md border border-gray-200 px-3 py-2 dark:border-gray-700" data-test-provider-exception={{row.exception.company_uuid}}>
                    <div class="w-1/3 truncate text-sm font-semibold">{{row.exception.company_name}}</div>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select flex-1">
                        <PowerSelectMultiple
                            @options={{this.exceptionProviderOptions}}
                            @selected={{row.selected}}
                            @onChange={{fn this.setExceptionProviders row.exception}}
                            @placeholder={{t "fleetops-ui.components.admin.routing-settings.select-providers"}}
                            @triggerClass="form-select form-input form-input-sm flex-1"
                            as |provider|
                        >
                            {{provider.label}}
                        </PowerSelectMultiple>
                    </div>
                    <Button @type="danger" @size="xs" @icon="trash" @onClick={{fn this.removeProviderException row.exception}} />
                </div>
            {{else}}
                <div class="text-sm text-gray-500">{{t "fleetops-ui.components.admin.routing-settings.no-exceptions-every-organization-follows-provider"}}</div>
            {{/each}}
        </div>
        <InputGroup @name={{t "fleetops-ui.components.admin.routing-settings.add-organization"}} class="mt-4">
            <ModelSelect
                @modelName="company"
                @query={{hash view="admin"}}
                @placeholder={{t "fleetops-ui.components.admin.routing-settings.search-organizations"}}
                @triggerClass="form-select form-input"
                @infiniteScroll={{false}}
                @renderInPlace={{true}}
                @onChange={{this.addProviderException}}
                as |company|
            >
                {{company.name}}
            </ModelSelect>
        </InputGroup>
    </ContentPanel>

    <ContentPanel @title={{t "fleetops-ui.components.admin.routing-settings.tracking-behaviour"}} @open={{true}} @wrapperClass="bordered-classic">
        <p class="mb-2 text-sm text-gray-600 dark:text-gray-400">
            {{t "fleetops-ui.components.admin.routing-settings.live-etas-remaining-distance-and-route"}}
        </p>
        <div class="flex justify-end">
            <Button
                @type="default"
                @size="xs"
                @icon={{if this.showTrackingAdvancedSettings "chevron-up" "chevron-down"}}
                @text={{t "fleetops-ui.components.admin.routing-settings.advanced-settings"}}
                @onClick={{this.toggleTrackingAdvancedSettings}}
            />
        </div>
        {{#if this.showTrackingAdvancedSettings}}
            <div class="mt-4 space-y-4 rounded-md border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-800">
                <InputGroup
                    @name={{t "fleetops-ui.components.admin.routing-settings.traffic-aware-eta"}}
                    @helpText={{t "fleetops-ui.components.admin.routing-settings.use-traffic-aware-provider-calculations-when"}}
                >
                    <Toggle @isToggled={{this.trackingTrafficEnabled}} @onToggle={{fn (mut this.trackingTrafficEnabled)}} />
                </InputGroup>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <InputGroup @name={{t "fleetops-ui.components.admin.routing-settings.summary-cache-ttl"}}>
                        <Input @type="number" @value={{this.trackingCacheTtlSeconds}} min="15" max="300" class="form-input w-full" />
                    </InputGroup>
                    <InputGroup @name={{t "fleetops-ui.components.admin.routing-settings.route-cache-ttl"}}>
                        <Input @type="number" @value={{this.trackingRouteCacheTtlSeconds}} min="60" max="1800" class="form-input w-full" />
                    </InputGroup>
                    <InputGroup @name={{t "fleetops-ui.components.admin.routing-settings.stale-location-threshold"}}>
                        <Input @type="number" @value={{this.trackingStaleLocationThresholdSeconds}} min="30" max="3600" class="form-input w-full" />
                    </InputGroup>
                    <InputGroup @name={{t "fleetops-ui.components.admin.routing-settings.fallback-speed"}}>
                        <Input @type="number" @value={{this.trackingDefaultVehicleSpeedKph}} min="1" max="160" class="form-input w-full" />
                    </InputGroup>
                </div>
            </div>
        {{/if}}
    </ContentPanel>

    <RegistryYield @registry="fleet-ops:component:admin:routing-settings" as |RegistryComponent|>
        <div>
            <RegistryComponent />
        </div>
    </RegistryYield>
    <Spacer @height="200px" />
</div>

<EmberWormhole @to="next-view-section-subheader-actions">
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "fleetops-ui.components.admin.routing-settings.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @isLoading={{or this.saveSettings.isRunning this.loadSettings.isRunning}}
        @disabled={{this.saveSettings.isRunning}}
    />
</EmberWormhole>