<ContentPanel @title={{t "fleetops-ui.components.admin.tracking-page-settings.generic-tracking-page"}} @open={{true}} @wrapperClass="bordered-classic">
    <div class="space-y-5">
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-sm font-semibold">{{t "fleetops-ui.components.admin.tracking-page-settings.enable-the-generic-tracking-page"}}</div>
                <div class="text-xs text-gray-600 dark:text-gray-300">{{t "fleetops-ui.components.admin.tracking-page-settings.serves-track-for-every-organization-that"}}</div>
            </div>
            <Toggle @isToggled={{this.genericEnabled}} @onToggle={{fn (mut this.genericEnabled)}} />
        </div>
        <div>
            <label for="admin-tracking-page-name" class="block text-sm font-semibold mb-1">{{t "fleetops-ui.components.admin.tracking-page-settings.display-name"}}</label>
            <input
                id="admin-tracking-page-name"
                type="text"
                class="form-input w-full"
                value={{this.displayName}}
                placeholder={{t "fleetops-ui.components.admin.tracking-page-settings.fleetbase"}}
                {{on "input" (fn this.setValue "displayName")}}
            />
            <p class="mt-1 text-xs text-gray-600 dark:text-gray-300">{{t "fleetops-ui.components.admin.tracking-page-settings.shown-before-a-lookup-the-logo"}}</p>
        </div>
        <div>
            <label for="admin-tracking-page-accent" class="block text-sm font-semibold mb-1">{{t "fleetops-ui.components.admin.tracking-page-settings.accent-colour"}}</label>
            <div class="flex items-center gap-3">
                <input
                    id="admin-tracking-page-accent"
                    type="color"
                    class="h-10 w-14 rounded-md border border-gray-300 dark:border-gray-700 bg-transparent cursor-pointer"
                    value={{this.accent}}
                    {{on "input" (fn this.setValue "accent")}}
                />
                <span class="font-mono text-sm">{{this.accent}}</span>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label for="admin-tracking-page-phone" class="block text-sm font-semibold mb-1">{{t "fleetops-ui.components.admin.tracking-page-settings.support-phone"}}</label>
                <input
                    id="admin-tracking-page-phone"
                    type="tel"
                    class="form-input w-full"
                    value={{this.supportPhone}}
                    placeholder="+1 555 010 0100"
                    {{on "input" (fn this.setValue "supportPhone")}}
                />
            </div>
            <div>
                <label for="admin-tracking-page-email" class="block text-sm font-semibold mb-1">{{t "fleetops-ui.components.admin.tracking-page-settings.support-email"}}</label>
                <input
                    id="admin-tracking-page-email"
                    type="email"
                    class="form-input w-full"
                    value={{this.supportEmail}}
                    placeholder="support@example.com"
                    {{on "input" (fn this.setValue "supportEmail")}}
                />
            </div>
            <div>
                <label for="admin-tracking-page-website" class="block text-sm font-semibold mb-1">{{t "fleetops-ui.components.admin.tracking-page-settings.website"}}</label>
                <input
                    id="admin-tracking-page-website"
                    type="url"
                    class="form-input w-full"
                    value={{this.website}}
                    placeholder="https://example.com"
                    {{on "input" (fn this.setValue "website")}}
                />
            </div>
        </div>
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-sm font-semibold">{{t "fleetops-ui.components.admin.tracking-page-settings.show-powered-by-fleetbase"}}</div>
                <div class="text-xs text-gray-600 dark:text-gray-300">{{t "fleetops-ui.components.admin.tracking-page-settings.the-default-for-organizations-that-haven"}}</div>
            </div>
            <Toggle @isToggled={{this.poweredBy}} @onToggle={{fn (mut this.poweredBy)}} />
        </div>
    </div>
</ContentPanel>

<EmberWormhole @to="next-view-section-subheader-actions">
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "fleetops-ui.components.admin.tracking-page-settings.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @isLoading={{or this.saveSettings.isRunning this.loadSettings.isRunning}}
        @disabled={{this.saveSettings.isRunning}}
    />
</EmberWormhole>