<Layout::Resource::Tabular
    @registry="fleet-ops:place:table"
    @resource="place"
    @title={{t "resource.places"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.placeActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="location-dot"
        title=(t "fleetops-ui.templates.management.places.index.hp.add-your-first-place")
        description=(t "fleetops-ui.templates.management.places.index.hp.places-keep-frequent-pickup-dropoff-facility")
        filteredTitle=(t "fleetops-ui.templates.management.places.index.hp.no-places-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.management.places.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.management.places.index.hp.new-place")
        primaryIcon="plus"
        primaryAction=this.placeActions.transition.create
        secondaryText=(t "fleetops-ui.templates.management.places.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.placeActions.import
        docsSlug="fleet-ops/resources/places/overview"
        docsTitle=(t "fleetops-ui.templates.management.places.index.hp.places-guide")
        docsText=(t "fleetops-ui.templates.management.places.index.hp.places-guide")
        docsSource="fleet-ops-empty-places"
    }}
/>
{{outlet}}
