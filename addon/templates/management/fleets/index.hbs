<Layout::Resource::Tabular
    @registry="fleet-ops:fleet:table"
    @resource="fleet"
    @title={{t "resource.fleets"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.fleetActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="layer-group"
        title=(t "fleetops-ui.templates.management.fleets.index.hp.create-your-first-fleet")
        description=(t "fleetops-ui.templates.management.fleets.index.hp.fleets-help-group-vehicles-and-drivers")
        filteredTitle=(t "fleetops-ui.templates.management.fleets.index.hp.no-fleets-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.management.fleets.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.management.fleets.index.hp.new-fleet")
        primaryIcon="plus"
        primaryAction=this.fleetActions.transition.create
        secondaryText=(t "fleetops-ui.templates.management.fleets.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.fleetActions.import
        docsSlug="fleet-ops/resources/fleets/overview"
        docsTitle=(t "fleetops-ui.templates.management.fleets.index.hp.fleets-guide")
        docsText=(t "fleetops-ui.templates.management.fleets.index.hp.fleet-guide")
        docsSource="fleet-ops-empty-fleets"
    }}
/>
{{outlet}}
