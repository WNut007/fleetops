<div class="flex h-full flex-col bg-gray-50 dark:bg-gray-900">
    <header class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 bg-white px-4 py-3 dark:border-gray-700 dark:bg-gray-900">
        <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
                <h1 class="text-lg font-bold text-gray-900 dark:text-gray-100">{{t
                        "fleetops-ui.templates.management.fuel-transactions.index.details.fuel-purchase"
                        provider_transaction_id=@model.provider_transaction_id
                    }}</h1>
                <FuelTransactionStatus @status={{@model.sync_status}} />
            </div>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{@model.provider}} · {{n-a @model.station_name}}</p>
        </div>
        <div class="flex items-center gap-2">
            <Button
                @icon="arrow-left"
                @text={{t "fleetops-ui.templates.management.fuel-transactions.index.details.back"}}
                @size="sm"
                @onClick={{transition-to "management.fuel-transactions.index"}}
            />
            <Button @icon="rotate" @text={{t "fleetops-ui.templates.management.fuel-transactions.index.details.reprocess"}} @size="sm" @onClick={{fn this.confirmAction "reprocess"}} />
        </div>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto p-4">
        <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-5">
            <div class="min-w-0 space-y-3 md:col-span-3">
                {{#each this.purchaseGroups as |group|}}
                    <section class="overflow-hidden rounded-md border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
                        <h2 class="border-b border-gray-200 px-3 py-2 text-sm font-semibold text-gray-900 dark:border-gray-700 dark:text-gray-100">{{group.title}}</h2>
                        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 p-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
                            {{#each group.rows as |row|}}
                                <div class="min-w-0"><dt class="text-xs text-gray-500 dark:text-gray-400">{{row.label}}</dt><dd
                                        class="break-words text-gray-900 dark:text-gray-100"
                                    >{{row.value}}</dd></div>
                            {{/each}}
                        </dl>
                    </section>
                {{/each}}
            </div>
            <section class="min-w-0 overflow-hidden rounded-md border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 md:col-span-2">
                <h2 class="border-b border-gray-200 px-3 py-2 text-sm font-semibold text-gray-900 dark:border-gray-700 dark:text-gray-100">{{t
                        "fleetops-ui.templates.management.fuel-transactions.index.details.matching-review"
                    }}</h2>
                <div class="space-y-3 p-3">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="min-w-0"><div class="text-xs text-gray-500 dark:text-gray-400">{{t "fleetops-ui.templates.management.fuel-transactions.index.details.vehicle"}}</div><div
                                class="mt-1 break-words text-sm text-gray-900 dark:text-gray-100"
                            >
                                {{#if this.vehicleResource}}
                                    <Vehicle::Pill @vehicle={{this.vehicleResource}} />
                                {{else}}
                                    {{t "fleetops-ui.templates.management.fuel-transactions.index.details.not-matched"}}
                                {{/if}}
                            </div></div>
                        <Button
                            @text={{if
                                @model.vehicle_uuid
                                (t "fleetops-ui.templates.management.fuel-transactions.index.details.change")
                                (t "fleetops-ui.templates.management.fuel-transactions.index.details.match")
                            }}
                            @size="xs"
                            @onClick={{fn this.confirmAction "vehicle"}}
                        />
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="min-w-0"><div class="text-xs text-gray-500 dark:text-gray-400">{{t
                                    "fleetops-ui.templates.management.fuel-transactions.index.details.order-trip"
                                }}</div><div class="mt-1 break-words text-sm text-gray-900 dark:text-gray-100">
                                {{#if this.orderResource}}
                                    <Order::Pill @order={{this.orderResource}} />
                                {{else}}
                                    {{t "fleetops-ui.templates.management.fuel-transactions.index.details.not-matched"}}
                                {{/if}}
                            </div></div>
                        <Button
                            @text={{if
                                @model.order_uuid
                                (t "fleetops-ui.templates.management.fuel-transactions.index.details.change")
                                (t "fleetops-ui.templates.management.fuel-transactions.index.details.match")
                            }}
                            @size="xs"
                            @onClick={{fn this.confirmAction "order"}}
                        />
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="min-w-0"><div class="text-xs text-gray-500 dark:text-gray-400">{{t
                                    "fleetops-ui.templates.management.fuel-transactions.index.details.fuel-report"
                                }}</div><div class="mt-1 break-words text-sm text-gray-900 dark:text-gray-100">
                                {{#if this.fuelReportResource}}
                                    <FuelReport::Pill @fuelReport={{this.fuelReportResource}} />
                                {{else}}
                                    {{t "fleetops-ui.templates.management.fuel-transactions.index.details.not-created"}}
                                {{/if}}
                            </div></div>
                        {{#if @model.fuel_report_id}}<Button
                                @text={{t "fleetops-ui.templates.management.fuel-transactions.index.details.open"}}
                                @size="xs"
                                @onClick={{this.openFuelReport}}
                            />{{/if}}
                    </div>
                    <div class="border-t border-gray-200 pt-3 dark:border-gray-700">
                        <p class="mb-2 text-xs text-gray-500 dark:text-gray-400">{{t
                                "fleetops-ui.templates.management.fuel-transactions.index.details.review-this-purchase-or-exclude-it"
                            }}</p>
                        <div class="flex flex-wrap gap-2">
                            <Button
                                @icon="check"
                                @text={{t "fleetops-ui.templates.management.fuel-transactions.index.details.mark-reviewed"}}
                                @type="success"
                                @size="xs"
                                @disabled={{eq @model.sync_status "reviewed"}}
                                @onClick={{fn this.confirmAction "reviewed"}}
                            />
                            <Button
                                @icon="ban"
                                @text={{t "fleetops-ui.templates.management.fuel-transactions.index.details.ignore"}}
                                @type="danger"
                                @size="xs"
                                @disabled={{eq @model.sync_status "ignored"}}
                                @onClick={{fn this.confirmAction "ignored"}}
                            />
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>