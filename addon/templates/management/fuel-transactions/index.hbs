{{#unless this.viewingDetails}}
    <div class="flex h-full flex-col bg-white dark:bg-gray-900">
        <div class="min-h-0 flex-1 overflow-y-auto">
            <Layout::Resource::Tabular
                @registry="fleet-ops:fuel-transaction:table"
                @resource="fuel-provider-transaction"
                @title={{t "menu.fuel-transactions"}}
                @searchQuery={{this.query}}
                @onSearch={{fn (mut this.query)}}
                @data={{@model}}
                @columns={{this.columns}}
                @page={{this.page}}
                @onPageChange={{fn (mut this.page)}}
                @setupTable={{fn (mut this.table)}}
                @actionButtons={{this.actionButtons}}
                @bulkActions={{this.bulkActions}}
                @controller={{this}}
                @emptyStateComponent={{component
                    "table/empty-state"
                    icon="receipt"
                    title=(if this.hasFilters (t "fleetops-ui.templates.management.fuel-transactions.index.hp.no-transactions-match-your-filters") (t "fleetops-ui.templates.management.fuel-transactions.index.hp.no-fuel-transactions"))
                    description=(t "fleetops-ui.templates.management.fuel-transactions.index.hp.imported-fuel-card-bills-and-provider")
                    filteredTitle=(t "fleetops-ui.templates.management.fuel-transactions.index.hp.no-transactions-match-your-filters")
                    filteredDescription=(t "fleetops-ui.templates.management.fuel-transactions.index.hp.adjust-the-search-or-filters-to")
                    primaryText=(t "fleetops-ui.templates.management.fuel-transactions.index.hp.refresh")
                    primaryIcon="refresh"
                    primaryAction=this.refresh
                    docsSlug="fleet-ops/resources/fuel-reports/overview"
                    docsTitle=(t "fleetops-ui.templates.management.fuel-transactions.index.hp.fuel-reports-guide")
                    docsText=(t "fleetops-ui.templates.management.fuel-transactions.index.hp.fuel-reports-guide")
                }}
            />

        </div>
    </div>
{{/unless}}
{{outlet}}