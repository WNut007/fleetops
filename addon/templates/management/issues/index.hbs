<Layout::Resource::Tabular
    @registry="fleet-ops:issue:table"
    @resource="issue"
    @title={{t "resource.issues"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.issueActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="triangle-exclamation"
        title=(t "fleetops-ui.templates.management.issues.index.hp.no-issues-reported")
        description=(t "fleetops-ui.templates.management.issues.index.hp.track-vehicle-driver-facility-and-service")
        filteredTitle=(t "fleetops-ui.templates.management.issues.index.hp.no-issues-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.management.issues.index.hp.clear-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.management.issues.index.hp.new-issue")
        primaryIcon="plus"
        primaryAction=this.issueActions.transition.create
        secondaryText=(t "fleetops-ui.templates.management.issues.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.issueActions.import
        docsSlug="fleet-ops/resources/issues/overview"
        docsTitle=(t "fleetops-ui.templates.management.issues.index.hp.issues-guide")
        docsText=(t "fleetops-ui.templates.management.issues.index.hp.issues-guide")
        docsSource="fleet-ops-empty-issues"
    }}
/>
{{outlet}}
