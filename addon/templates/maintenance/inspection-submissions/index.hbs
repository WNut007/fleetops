<Layout::Resource::Tabular
    @registry="fleet-ops:inspection-submission:table"
    @resource="inspection-submission"
    @title={{t "fleetops-ui.templates.maintenance.inspection-submissions.index.inspections"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.inspectionSubmissionActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="list-check"
        title=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.no-inspections-yet")
        description=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.capture-dvir-submissions-and-turn-failed")
        filteredTitle=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.no-inspections-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.adjust-search-or-filters-to-find")
        primaryText=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.new-inspection")
        primaryIcon="plus"
        primaryAction=this.inspectionSubmissionActions.transition.create
        docsSlug="fleet-ops/maintenance/inspections/overview"
        docsTitle=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.inspections-guide")
        docsText=(t "fleetops-ui.templates.maintenance.inspection-submissions.index.hp.inspections-guide")
    }}
/>
{{outlet}}