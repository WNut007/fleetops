<Layout::Resource::Tabular
    @registry="fleet-ops:work-order:table"
    @resource="work-order"
    @title={{t "resource.work-orders"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.workOrderActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="clipboard-list"
        title=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.no-work-orders-yet")
        description=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.create-work-orders-to-assign-maintenance")
        filteredTitle=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.no-work-orders-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.new-work-order")
        primaryIcon="plus"
        primaryAction=this.workOrderActions.transition.create
        secondaryText=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.workOrderActions.import
        docsSlug="fleet-ops/maintenance/work-orders/overview"
        docsTitle=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.work-orders-guide")
        docsText=(t "fleetops-ui.templates.maintenance.work-orders.index.hp.work-orders-guide")
        docsSource="fleet-ops-empty-work-orders"
    }}
/>
{{outlet}}
