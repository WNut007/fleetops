<Layout::Resource::Tabular
    @registry="fleet-ops:inspection-form:table"
    @resource="inspection-form"
    @title={{t "fleetops-ui.templates.maintenance.inspection-forms.index.inspection-forms"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.inspectionFormActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="clipboard-check"
        title=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.create-your-first-inspection-form")
        description=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.build-dvir-and-safety-checklists-drivers")
        filteredTitle=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.no-inspection-forms-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.adjust-search-or-filters-to-find")
        primaryText=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.new-form")
        primaryIcon="plus"
        primaryAction=this.inspectionFormActions.transition.create
        docsSlug="fleet-ops/maintenance/inspections/overview"
        docsTitle=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.inspections-guide")
        docsText=(t "fleetops-ui.templates.maintenance.inspection-forms.index.hp.inspections-guide")
    }}
/>
{{outlet}}