<Layout::Resource::Tabular
    @registry="fleet-ops:maintenance:table"
    @resource="maintenance"
    @title={{t "resource.maintenances"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.maintenanceActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="screwdriver-wrench"
        title=(t "fleetops-ui.templates.maintenance.maintenances.index.hp.no-maintenance-records-yet")
        description=(t "fleetops-ui.templates.maintenance.maintenances.index.hp.log-maintenance-events-to-keep-service")
        filteredTitle=(t "fleetops-ui.templates.maintenance.maintenances.index.hp.no-maintenance-records-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.maintenance.maintenances.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.maintenance.maintenances.index.hp.new-maintenance")
        primaryIcon="plus"
        primaryAction=this.maintenanceActions.transition.create
        secondaryText=(t "fleetops-ui.templates.maintenance.maintenances.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.maintenanceActions.import
    }}
/>
{{outlet}}
