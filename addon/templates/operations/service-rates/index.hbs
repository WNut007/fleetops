<Layout::Resource::Tabular
    @registry="fleet-ops:service-rate:table"
    @resource="service-rate"
    @title={{t "resource.service-rates"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.serviceRateActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="route"
        title=(t "fleetops-ui.templates.operations.service-rates.index.hp.set-up-your-first-service-rate")
        description=(t "fleetops-ui.templates.operations.service-rates.index.hp.service-rates-define-how-fleet-ops")
        filteredTitle=(t "fleetops-ui.templates.operations.service-rates.index.hp.no-service-rates-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.operations.service-rates.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.operations.service-rates.index.hp.new-service-rate")
        primaryIcon="plus"
        primaryAction=this.serviceRateActions.transition.create
        secondaryText=(t "fleetops-ui.templates.operations.service-rates.index.hp.refresh")
        secondaryIcon="refresh"
        secondaryAction=this.serviceRateActions.refresh
        docsSlug="fleet-ops/operations/service-rates/overview"
        docsTitle=(t "fleetops-ui.templates.operations.service-rates.index.hp.service-rates-guide")
        docsText=(t "fleetops-ui.templates.operations.service-rates.index.hp.service-rates-guide")
        docsSource="fleet-ops-empty-service-rates"
    }}
/>
{{outlet}}
