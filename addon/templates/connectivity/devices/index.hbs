<Layout::Resource::Tabular
    @registry="fleet-ops:device:table"
    @resource="device"
    @title={{t "resource.devices"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.deviceActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="tablet-screen-button"
        title=(t "fleetops-ui.templates.connectivity.devices.index.hp.add-your-first-device")
        description=(t "fleetops-ui.templates.connectivity.devices.index.hp.devices-connect-vehicles-and-assets-to")
        filteredTitle=(t "fleetops-ui.templates.connectivity.devices.index.hp.no-devices-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.connectivity.devices.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.connectivity.devices.index.hp.new-device")
        primaryIcon="plus"
        primaryAction=this.deviceActions.transition.create
        secondaryText=(t "fleetops-ui.templates.connectivity.devices.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.deviceActions.import
        docsSlug="fleet-ops/connectivity/devices/overview"
        docsTitle=(t "fleetops-ui.templates.connectivity.devices.index.hp.devices-guide")
        docsText=(t "fleetops-ui.templates.connectivity.devices.index.hp.device-guide")
        docsSource="fleet-ops-empty-devices"
    }}
/>
{{outlet}}
