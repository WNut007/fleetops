<div class="mx-auto w-full max-w-7xl px-4 py-4 md:px-6">
    <section class="rounded-md border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.templates.connectivity.fuel-providers.details.matching.transaction-matching"}}</h2>
        <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-300">{{t "fleetops-ui.templates.connectivity.fuel-providers.details.matching.this-is-the-order-used-when"}}</p>
        <div class="mt-4">
            <FuelIntegration::MatchingPriority @order={{@model.sync_settings.matching_order}} />
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            <Button
                @icon="receipt"
                @text={{t "fleetops-ui.templates.connectivity.fuel-providers.details.matching.review-unmatched-transactions"}}
                @size="sm"
                @onClick={{this.reviewUnmatchedTransactions}}
            />
            <Button
                @icon="cog"
                @text={{t "fleetops-ui.templates.connectivity.fuel-providers.details.matching.edit-matching-rules"}}
                @size="sm"
                @onClick={{transition-to "connectivity.fuel-providers.edit" @model}}
            />
        </div>
    </section>
</div>