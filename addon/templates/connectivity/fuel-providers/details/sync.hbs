<div class="space-y-4 p-4">
    <section class="rounded-md border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.import-transactions"}}</h2>
        <p class="mt-1 text-xs leading-5 text-gray-500 dark:text-gray-400">{{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.choose-the-purchase-dates-to-import"}}</p>
        <div class="mt-4 flex flex-wrap items-end gap-4">
            <InputGroup @name={{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.start-date"}} @wrapperClass="mb-0">
                <input
                    type="date"
                    aria-label={{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.start-date"}}
                    class="form-input"
                    value={{this.from}}
                    {{on "change" (fn this.setDate "from")}}
                />
            </InputGroup>
            <InputGroup @name={{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.end-date"}} @wrapperClass="mb-0">
                <input
                    type="date"
                    aria-label={{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.end-date"}}
                    class="form-input"
                    value={{this.to}}
                    {{on "change" (fn this.setDate "to")}}
                />
            </InputGroup>
            <Button
                @icon="rotate"
                @text={{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.sync-transactions"}}
                @type="primary"
                @size="sm"
                @wrapperClass="flex-shrink-0"
                @textClass="whitespace-nowrap"
                @disabled={{this.syncDisabled}}
                @isLoading={{this.details.syncTransactions.isRunning}}
                @onClick={{this.sync}}
            />
        </div>
        {{#if this.dateError}}<p class="mt-3 text-xs text-red-600 dark:text-red-300" role="alert">{{this.dateError}}</p>{{/if}}
        {{#if this.details.hasPendingSync}}<p class="mt-3 text-xs text-blue-600 dark:text-blue-300" role="status">{{t
                    "fleetops-ui.templates.connectivity.fuel-providers.details.sync.a-sync-is-in-progress-results"
                }}</p>{{/if}}
    </section>
    <section class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="flex items-center justify-between gap-3 border-b border-gray-200 p-4 dark:border-gray-700">
            <div>
                <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.sync-history"}}</h2>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.latest-20-runs-times-shown-in"}}</p>
            </div>
            <Button @icon="refresh" @text={{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.refresh"}} @size="xs" @onClick={{this.details.refreshActivity}} />
        </div>
        <div class="divide-y divide-gray-200 dark:divide-gray-700">
            {{#each this.details.runs as |run|}}
                <article class="p-4" data-test-sync-run={{run.uuid}}>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-3">
                            <Badge @status={{run.tone}}>{{run.label}}</Badge>
                            <span class="text-sm font-medium text-gray-900 dark:text-gray-100" dir="ltr">{{run.window}}</span>
                        </div>
                        <time class="text-xs text-gray-500 dark:text-gray-400" dir="ltr">{{run.date}}</time>
                    </div>
                    <p class="mt-3 text-sm text-gray-700 dark:text-gray-300" role="status">{{run.result}}</p>
                    {{#if run.received}}
                        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-xs text-gray-500 dark:text-gray-400">
                            <span>{{t "fleetops-ui.templates.connectivity.fuel-providers.details.sync.read" received=run.received}}</span><span>{{t
                                    "fleetops-ui.templates.connectivity.fuel-providers.details.sync.vehicle-matched"
                                    matched=run.matched
                                }}</span><span>{{t
                                    "fleetops-ui.templates.connectivity.fuel-providers.details.sync.fuel-reports-created"
                                    fuel_reports_created=run.fuel_reports_created
                                }}</span>
                        </div>
                    {{/if}}
                </article>
            {{else}}
                <div class="p-8 text-center"><FaIcon @icon="history" class="text-gray-400" /><h3 class="mt-3 text-sm font-semibold text-gray-900 dark:text-gray-100">{{t
                            "fleetops-ui.templates.connectivity.fuel-providers.details.sync.no-sync-history-yet"
                        }}</h3><p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t
                            "fleetops-ui.templates.connectivity.fuel-providers.details.sync.choose-a-date-range-above-to"
                        }}</p></div>
            {{/each}}
        </div>
    </section>
</div>