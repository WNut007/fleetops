<div class="w-full">
    <Layout::Resource::Tabular
        @resource="fuel-provider-transaction"
        @title={{t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.imported-transactions"}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{this.page}}
        @searchQuery={{this.query}}
        @onSearch={{fn (mut this.query)}}
        @onPageChange={{fn (mut this.page)}}
        @setupTable={{fn (mut this.table)}}
        @onReload={{this.refresh}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="receipt"
            title=(if this.hasFilters (t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.no-transactions-match-your-filters") (t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.no-imported-transactions"))
            description=(if this.hasFilters (t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.adjust-or-clear-the-filters-to") (t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.fuel-transactions-appear-here-after-this"))
            filteredTitle=(t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.no-transactions-match-your-filters")
            filteredDescription=(t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.adjust-filters-or-sync-the-provider")
            primaryText=(t "fleetops-ui.templates.connectivity.fuel-providers.details.transactions.hp.refresh")
            primaryIcon="refresh"
            primaryAction=this.refresh
        }}
    />
</div>