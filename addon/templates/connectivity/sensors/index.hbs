<Layout::Resource::Tabular
    @registry="fleet-ops:sensor:table"
    @resource="sensor"
    @title={{t "resource.sensors"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.sensorActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="satellite-dish"
        title=(t "fleetops-ui.templates.connectivity.sensors.index.hp.add-your-first-sensor")
        description=(t "fleetops-ui.templates.connectivity.sensors.index.hp.sensors-capture-telemetry-signals-that-can")
        filteredTitle=(t "fleetops-ui.templates.connectivity.sensors.index.hp.no-sensors-match-your-filters")
        filteredDescription=(t "fleetops-ui.templates.connectivity.sensors.index.hp.adjust-the-search-or-filters-to")
        primaryText=(t "fleetops-ui.templates.connectivity.sensors.index.hp.new-sensor")
        primaryIcon="plus"
        primaryAction=this.sensorActions.transition.create
        secondaryText=(t "fleetops-ui.templates.connectivity.sensors.index.hp.import")
        secondaryIcon="upload"
        secondaryAction=this.sensorActions.import
        docsSlug="fleet-ops/connectivity/sensors/overview"
        docsTitle=(t "fleetops-ui.templates.connectivity.sensors.index.hp.sensors-guide")
        docsText=(t "fleetops-ui.templates.connectivity.sensors.index.hp.sensors-guide")
        docsSource="fleet-ops-empty-sensors"
    }}
/>
{{outlet}}
