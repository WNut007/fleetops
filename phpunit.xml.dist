<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./server/vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
>
    <testsuites>
        <testsuite name="default">
            <directory suffix=".php">./server/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./server/src</directory>
        </include>
    </source>
    <php>
        <!-- The contract tests assert the English server texts; the deployed default is Thai. -->
        <env name="FLEETOPS_SERVER_TEXT_LOCALE" value="en"/>
    </php>
</phpunit>
